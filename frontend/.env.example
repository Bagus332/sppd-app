# API Configuration
# BACKEND_URL: Server-side only, used by Next.js rewrites to proxy requests to backend
# For Vercel: Set this to your backend URL
# For local: Leave as http://localhost:8080
BACKEND_URL=http://localhost:8080

# NEXT_PUBLIC_API_URL: Client-side, should be EMPTY on Vercel to use relative paths
# For local dev: Can be empty or http://localhost:8080 (both work with rewrites)
NEXT_PUBLIC_API_URL=
